#!/bin/sh
# Commit-msg hook for cargo-commitlint
# Validates commit messages using this project's own cargo-commitlint binary
#
# NOTE: keep the validation invocation in sync with generate_hook_script() in src/hook.rs.
# The binary resolution below deliberately differs (it searches target/ first), but the
# `check < "$COMMIT_MSG_FILE"` invocation and the stderr-directed skip warning must match
# the installed hook. See test_husky_hook_and_generated_hook_agree_on_invocation.

set -e

COMMIT_MSG_FILE="$1"

# Find the git repository root
GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
cd "$GIT_ROOT"

# Determine which binary to use (prefer release, then debug, then PATH)
if [ -x "./target/release/cargo-commitlint" ]; then
    CARGO_COMMITLINT="./target/release/cargo-commitlint"
elif [ -x "./target/debug/cargo-commitlint" ]; then
    CARGO_COMMITLINT="./target/debug/cargo-commitlint"
elif command -v cargo-commitlint >/dev/null 2>&1; then
    CARGO_COMMITLINT="cargo-commitlint"
else
    echo "⚠️  cargo-commitlint binary not found (run 'cargo build --release' once to enable commit message validation). Skipping." >&2
    exit 0
fi

# Validate commit message using the resolved binary
echo "📝 Validating commit message with cargo commitlint..."
if ! "$CARGO_COMMITLINT" check < "$COMMIT_MSG_FILE"; then
    echo "❌ Commit message validation failed."
    echo "   Please follow Conventional Commits specification."
    exit 1
fi

echo "✅ Commit message is valid!"
exit 0

